{
  "expo": {
    "name": "Dolibarr Caisse POS",
    "slug": "dolibarr-pos",
    "version": "1.0.4",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ikaiss.dolibarrpos",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin de la caméra pour scanner les codes-barres des produits.",
        "NSBluetoothAlwaysUsageDescription": "L'application a besoin du Bluetooth pour se connecter aux imprimantes de tickets.",
        "NSBluetoothPeripheralUsageDescription": "L'application a besoin du Bluetooth pour se connecter aux imprimantes de tickets."
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.ikaiss.dolibarrpos",
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {},
    "scheme": "dolibarr-pos",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permettre l'utilisation de Face ID pour sécuriser vos données."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
